<Window x:Class="PR_21.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR_21"
        mc:Ignorable="d"
        Title="Диспетчеры Компановки" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ButtonStyleSquare">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TextBlockStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <TextBlock Text="Последние документы" Style="{StaticResource TextBlockStyle}" />
            <Button Content="Открыть" Style="{StaticResource ButtonStyle}" />
            <Button Content="Сохранить" Style="{StaticResource ButtonStyle}" />
            <Button Content="Закрыть" Style="{StaticResource ButtonStyle}" />
            <Button Content="Обработка" Style="{StaticResource ButtonStyle}" />
            <Button Content="О программе" Style="{StaticResource ButtonStyle}" />
        </StackPanel>
        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
            <TextBlock Text="1.txt" />
            <TextBlock Text="2.txt" />
            <TextBlock Text="3.txt" />
            <TextBlock Text="4.txt" />
            <TextBlock Text="5.txt" />
            <TextBlock Text="6.txt" />
            <TextBlock Text="7.txt" />
        </StackPanel>

        <WrapPanel Orientation="Horizontal" Style="{x:Null}">
            <Button Content="Кнопка 1" Style="{StaticResource ButtonStyleSquare}" Background="Coral"/>
            <Button Content="Кнопка 2" Style="{StaticResource ButtonStyleSquare}" Background="Aqua"/>
            <Button Content="Кнопка 3" Style="{StaticResource ButtonStyleSquare}" Background="LightGreen"/>
            <Button Content="Кнопка 4" Style="{StaticResource ButtonStyleSquare}" Background="LightBlue"/>
            <Button Content="Кнопка 5" Style="{StaticResource ButtonStyleSquare}" Background="LightYellow"/>
        </WrapPanel>


    </DockPanel>


</Window>
